function ftex(){
  killall inkscape-figures
  mkdir -p figures
  cd figures
  inkscape-figures watch
  cd ..
  vim "$1".tex
}

# Prefer fzf, but allow skim on machines where it is already installed.
function _dotfiles_fuzzy_select() {
  if (( $+commands[fzf] )); then
    command fzf "$@"
  elif (( $+commands[sk] )); then
    command sk "$@"
  else
    print -u2 'Directory/history picker requires fzf or skim.'
    return 127
  fi
}

function fad() {
  local dir
  dir=$(find "$HOME" \( -name .cache -o -name .git -o -name node_modules \
      -o -name .wine -o -name wine -o -name linux-tkg \) -prune \
      -o -type d -print 2>/dev/null | _dotfiles_fuzzy_select --no-multi --preview 'ls -ld -- {}' -q "$*") || return
  [[ -n "$dir" ]] && cd -- "$dir"
}

function cpd(){
  if [ -z "$1" ]; then
    cd usaco
  else
    mkdir "$1"
    cd "$1"
    touch "$1".in
    touch "$1".out
    vim "$1".cpp
  fi
}

function fd() {
  local dir
  dir=$(find . \( -name .git -o -name node_modules -o -name .wine       -o -name wine -o -name linux-tkg \) -prune       -o -type d -print 2>/dev/null | _dotfiles_fuzzy_select --no-multi --preview 'ls -ld -- {}' -q "$*") || return
  [[ -n "$dir" ]] && cd -- "$dir"
}

function fh() {
  local choice
  choice=$(fc -l -r 1 | _dotfiles_fuzzy_select --no-multi -q "$*" | sed 's/ *[0-9]*\*\{0,1\} *//') || return
  [[ -n "$choice" ]] && print -z -- "$choice"
}

function ccsv() {
    mcs -out:"$1" "$1.cs"
    mono "$1"
}

function ccs() {
    mcs -out:"$1" "$1.cs"
}

function gacp() {
  if [[ -z "$1" ]]; then
    print -u2 'Usage: gacp "commit message"'
    return 2
  fi
  git add -A && git commit -m "$1" && git push
}
function lg() {
  nohup ~/.zsh/scripts/winview "$@" >/dev/null 2>&1 &
}

