#!/usr/bin/env bash

# Display thermal zone temperature, or report a missing sensor.
temp_file="/sys/class/thermal/thermal_zone0/temp"
if [[ ! -r "$temp_file" ]]; then
  printf 'Temperature sensor unavailable\n' >&2
  exit 1
fi

read -r millidegrees < "$temp_file"
if [[ ! "$millidegrees" =~ ^[0-9]+$ ]]; then
  printf 'Invalid temperature reading\n' >&2
  exit 1
fi
printf '%d°C\n' "$((millidegrees / 1000))"
