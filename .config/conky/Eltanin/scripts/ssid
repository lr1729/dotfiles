#!/usr/bin/env bash

# Display the connected Wi-Fi SSID; fall back to NetworkManager when iwgetid is absent.
ssid=''
if command -v iwgetid >/dev/null 2>&1; then
  ssid="$(iwgetid -r 2>/dev/null || :)"
fi
if [[ -z "$ssid" ]] && command -v nmcli >/dev/null 2>&1; then
  ssid="$(nmcli -t -f IN-USE,SSID device wifi list --rescan no 2>/dev/null | sed -n 's/^\*://p' | head -n 1)"
fi

if [[ -z "$ssid" ]]; then
  printf 'Not Connected\n'
elif [[ "${1:-}" == '-i' ]]; then
  printf '  %s\n' "$ssid"
else
  printf '%s\n' "$ssid"
fi
